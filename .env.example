# Copy to .env and paste your own key.
# Free key: https://www.themoviedb.org/settings/api (v3 auth, "API Key")
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so this key
# ships inside the app. Fine for a personal build; do not treat it as a secret.
EXPO_PUBLIC_TMDB_API_KEY=

# Optional: keep your data in Cloudflare D1 behind a sign-in (see README,
# "Cloud data"), e.g. https://memoti.<you>.workers.dev/api. Blank = on-device
# SQLite.
EXPO_PUBLIC_MEMOTI_API_URL=
